# ==============================
# AGENTWORK - SOMNIA CONFIG
# ==============================

# Somnia Network
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_CHAIN_ID=50312

# Wallet (replace locally only)
AGENT_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
DEPLOYER_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Contract Address (after deployment)
CONTRACT_ADDRESS=YOUR_DEPLOYED_CONTRACT

# Somnia Agent Kit
AGENT_REGISTRY_ADDRESS=0xC9f3452090EEB519467DEa4a390976D38C008347
AGENT_MANAGER_ADDRESS=0x77F6dC5924652e32DBa0B4329De0a44a2C95691E
AGENT_EXECUTOR_ADDRESS=0x157C56dEdbAB6caD541109daabA4663Fc016026e
AGENT_VAULT_ADDRESS=0x7cEe3142A9c6d15529C322035041af697B2B5129

# AgentWork
COMPANY_NAME=AgentWork
COMPANY_MODE=AUTONOMOUS
REPUTATION_START=100
SOMI_ESCROW_ENABLED=true

# AI Agents
CEO_AGENT=enabled
PLANNER_AGENT=enabled
RECRUITER_AGENT=enabled
EXECUTION_AGENT=enabled
AUDITOR_AGENT=enabled

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/agentwork

# Backend
API_PORT=8000

# Frontend
NEXT_PUBLIC_APP_NAME=AgentWork
NEXT_PUBLIC_CHAIN_ID=50312
NEXT_PUBLIC_NETWORK=Somnia

# Demo Mode
DEMO_MODE=true
